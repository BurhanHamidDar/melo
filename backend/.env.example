APP_ENV=production
APP_PORT=8080
PUBLIC_API_BASE_URL=https://api.burhanhamid.in
LOG_LEVEL=info

# Neon PostgreSQL Connection URLs
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require

# Firebase Admin SDK
FIREBASE_PROJECT_ID=melo-v2
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# Cloudflare R2 Image & Release Storage
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_IMAGES_BUCKET=melo-images
R2_RELEASES_BUCKET=melo-releases
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_IMAGE_BASE_URL=https://images.burhanhamid.in
R2_PRESIGN_TTL_SECONDS=300

# Security & CORS
ALLOWED_ADMIN_ORIGINS=https://admin.applicoda.in,https://melo.applicoda.in,https://admin.burhanhamid.in,https://melo.burhanhamid.in,http://localhost:3000
RATE_LIMIT_ENABLED=true
