APP_ENV=development
APP_PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8080
LOG_LEVEL=debug

# Neon PostgreSQL Connection URLs
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require

# Firebase Admin SDK
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# Cloudflare R2 Image & Release Storage
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_IMAGES_BUCKET=melo-images-dev
R2_RELEASES_BUCKET=melo-releases-dev
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_IMAGE_BASE_URL=https://images.example.com
R2_PRESIGN_TTL_SECONDS=300

# Security & CORS
ALLOWED_ADMIN_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
